#!/usr/bin/env bash
# Run the supplied check from a disposable copy of the current Git index.
set -euo pipefail
if [ "$#" -eq 0 ]; then
  echo "Usage: verify-staged COMMAND [ARG...]" >&2
  exit 2
fi
root=$(git rev-parse --show-toplevel)
tree=$(git write-tree)
if git ls-tree -r "$tree" | grep '^160000 ' >/dev/null; then
  echo "Staged snapshot contains submodules. Verify their pinned checkouts separately." >&2
  exit 2
fi
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
mkdir "$stage/source"
GIT_INDEX_FILE="$stage/index" git -C "$root" read-tree "$tree"
GIT_INDEX_FILE="$stage/index" git -C "$root" checkout-index --all --ignore-skip-worktree-bits --prefix="$stage/source/"
(
  while IFS= read -r name; do unset "$name"; done < <(git rev-parse --local-env-vars)
  cd "$stage/source"
  export GIT_CEILING_DIRECTORIES="$stage"
  "$@"
)
if [ "$(git write-tree)" != "$tree" ]; then
  echo "The index changed while verifying $tree. Rerun for the current staged tree." >&2
  exit 1
fi
echo "Verified staged tree $tree"
