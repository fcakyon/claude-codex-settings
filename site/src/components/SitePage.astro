---
import Layout from "../layouts/Layout.astro"
import { providerNames, site } from "../lib/content"
import { locales, translations, type Locale } from "../lib/i18n"
import PluginsPage from "./PluginsPage.astro"
import SettingsPage from "./SettingsPage.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = translations[locale][site.variant]
const providers = providerNames.join(locale === "en" ? ", " : "、")
---

<Layout locale={locale} variant={site.variant} title={copy.meta.title} canonical={`${site.url}${locales[locale].path}`}>
  {site.variant === "settings" ? <SettingsPage locale={locale} providers={providers} /> : <PluginsPage locale={locale} />}
</Layout>
