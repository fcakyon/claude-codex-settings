---
import Icon from "./Icon.astro"
import PluginCard from "./PluginCard.astro"
import SkillCard from "./SkillCard.astro"
import { plugins, popularSkills } from "../lib/content"

interface Props {
  kind: "plugin" | "skill"
}

const { kind } = Astro.props
const items = kind === "plugin" ? plugins : popularSkills
const categories = Object.entries(Object.groupBy(items, (item) => item.category || "other")).sort(([a], [b]) => a.localeCompare(b))
---

<div class="hub" data-hub={kind}>
  <div class="hub-filters">
    <label class="hub-search">
      <Icon name="search" size={20} />
      <span class="sr-only">Search {kind}s</span>
      <input type="search" name="q" placeholder={`Search ${items.length} ${kind}s by name or task…`} autocomplete="off" data-hub-search />
    </label>
    <div class="hub-chips" role="group" aria-label="Filter by category">
      <button type="button" aria-pressed="true" data-hub-category="">All <span>{items.length}</span></button>
      {categories.map(([category, categoryItems]) => (
        <button type="button" aria-pressed="false" data-hub-category={category}>{category.replaceAll("-", " ")} <span>{categoryItems?.length}</span></button>
      ))}
    </div>
  </div>
  <ul class="plugin-grid" role="list">
    {kind === "plugin"
      ? plugins.map((item) => (
          <li style={`view-transition-name: plugin-${item.name}`} data-category={item.category || "other"} data-search={item.search}>
            <PluginCard plugin={item} />
          </li>
        ))
      : popularSkills.map((item) => (
          <li data-category={item.category || "other"} data-search={item.search}>
            <SkillCard skill={item} />
          </li>
        ))}
  </ul>
  <p class="hub-empty" data-hub-empty hidden>No {kind}s match. Try a shorter word or pick All.</p>
  <p class="sr-only" aria-live="polite" data-hub-count></p>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-hub]").forEach((hub) => {
    const search = hub.querySelector<HTMLInputElement>("[data-hub-search]")!
    const chips = [...hub.querySelectorAll<HTMLButtonElement>("[data-hub-category]")]
    const items = [...hub.querySelectorAll<HTMLElement>("[data-search]")]
    const empty = hub.querySelector<HTMLElement>("[data-hub-empty]")!
    const count = hub.querySelector<HTMLElement>("[data-hub-count]")!
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)")
    let category = ""
    const filter = () => {
      const query = search.value.trim().toLowerCase()
      let visible = 0
      items.forEach((item) => {
        item.hidden = (category !== "" && item.dataset.category !== category) || !item.dataset.search?.includes(query)
        visible += Number(!item.hidden)
      })
      empty.hidden = visible > 0
      count.textContent = visible ? `${visible} ${hub.dataset.hub}${visible === 1 ? "" : "s"} shown` : empty.textContent
    }
    search.addEventListener("input", filter)
    chips.forEach((chip) =>
      chip.addEventListener("click", () => {
        category = chip.dataset.hubCategory || ""
        chips.forEach((item) => item.setAttribute("aria-pressed", String(item === chip)))
        // a skipped transition (rapid clicks, hidden tab) rejects `ready` after still running filter
        if (document.startViewTransition && !reducedMotion.matches) document.startViewTransition(filter).ready.catch(() => {})
        else filter()
      }),
    )
  })
</script>
