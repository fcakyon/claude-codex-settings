---
import DownloadCount from "./DownloadCount.astro"
import InstallGuide from "./InstallGuide.astro"
import PluginCard from "./PluginCard.astro"
import SkillCard from "./SkillCard.astro"
import ToolIcons from "./ToolIcons.astro"
import { downloadStats, featured, plugins, skillsByPlugin } from "../lib/content"

interface Props {
  plugin: (typeof plugins)[number]
}

const { plugin } = Astro.props
const pluginSkills = skillsByPlugin[plugin.name] ?? []
const downloads = [...new Set([...pluginSkills.map((skill) => skill.asset), `${plugin.name}.zip`])].reduce((sum, asset) => sum + (downloadStats.assets[asset]?.count || 0), 0)
const extras = [
  ["Agents", plugin.components?.agents],
  ["Commands", plugin.components?.commands],
  ["Output styles", plugin.components?.outputStyles],
].filter(([, items]) => items?.length) as [string, string[]][]
const sameCategory = plugins.filter((item) => item.category === plugin.category && item.name !== plugin.name)
const related = (sameCategory.length ? sameCategory : plugins.filter((item) => featured.includes(item.name) && item.name !== plugin.name)).slice(0, 3)
---

<div class="catalog-hero">
  <div class="catalog-hero-copy">
    <DownloadCount count={downloads} />
    <h1 style={`view-transition-name: plugin-name-${plugin.name}`}>{plugin.seo.title}</h1>
    <p>{plugin.description}</p>
    <dl class="plugin-facts">
      <div><dt>Works with</dt><dd><ToolIcons {plugin} size={18} /></dd></div>
      {plugin.summary && <div><dt>Includes</dt><dd>{plugin.summary}</dd></div>}
      <div><dt>Version</dt><dd>{plugin.version}</dd></div>
      {plugin.license && <div><dt>License</dt><dd>{plugin.license}</dd></div>}
    </dl>
    <a class="official-link" href={plugin.href}>Source on GitHub</a>
  </div>
  <aside class="catalog-install">
    <h2>Install {plugin.name}</h2>
    <InstallGuide {plugin} />
  </aside>
</div>

{(pluginSkills.length > 0 || extras.length > 0) && (
  <section class="content-section" id="skills">
    {pluginSkills.length > 0 && (
      <>
        <h2>{pluginSkills.length === 1 ? "Skill" : `${pluginSkills.length} skills`}</h2>
        <div class="plugin-grid">{pluginSkills.map((item) => <SkillCard skill={item} describe={pluginSkills.length > 1} showPlugin={false} />)}</div>
      </>
    )}
    {extras.length > 0 && (
      <dl class="plugin-extras">
        {extras.map(([label, items]) => (
          <div><dt>{label}</dt><dd>{items.map((item) => <code>{item}</code>)}</dd></div>
        ))}
      </dl>
    )}
  </section>
)}

<section class="content-section related-plugins">
  <h2>{sameCategory.length ? `More ${plugin.category?.replaceAll("-", " ")} plugins` : "Featured plugins"}</h2>
  <div class="plugin-grid">{related.map((item) => <PluginCard plugin={item} />)}</div>
</section>
