---
import Breadcrumbs from "./Breadcrumbs.astro"
import InstallGuide from "./InstallGuide.astro"
import PluginHub from "./PluginHub.astro"
import PluginPage from "./PluginPage.astro"
import Icon from "./Icon.astro"
import DownloadCount from "./DownloadCount.astro"
import SkillDownload from "./SkillDownload.astro"
import Layout from "../layouts/Layout.astro"
import {
  configurationDocuments,
  downloadStats,
  pluginByName,
  plugins,
  repositoryUrl,
  site,
  skills,
  skillByKey,
  skillsByPlugin,
  sourceDocuments,
  type ContentPage,
} from "../lib/content"

interface Props {
  page: ContentPage
}

const { page } = Astro.props
const canonical = `${site.url}/${page.path}/`
const homeCrumb = { label: "Home", href: "/" }
const skillGroups = Object.entries(skillsByPlugin).sort(([a], [b]) => a.localeCompare(b))
const settingsCards = [
  {
    title: "Configure Claude Code",
    description: "Use the repository settings file, hooks, permissions, and environment layout for Claude Code.",
    href: "/settings/claude-code/",
  },
  {
    title: "Configure OpenAI Codex",
    description: "Use the repository TOML configuration, plugins, model settings, and project guidance for Codex.",
    href: "/settings/codex/",
  },
  {
    title: "Use Kimi models",
    description: "Compare the Claude Code and Codex files configured for Kimi models.",
    href: "/settings/providers/kimi/",
  },
  {
    title: "Use MiniMax models",
    description: "Compare the Claude Code and Codex files configured for MiniMax models.",
    href: "/settings/providers/minimax/",
  },
  {
    title: "Use Z.ai models",
    description: "Compare the Claude Code and Codex files configured for Z.ai and GLM models.",
    href: "/settings/providers/zai/",
  },
  {
    title: "Write a CLAUDE.md file",
    description: "Use the repository guidance file as a practical reference for agent instructions.",
    href: "/guides/claude-md/",
  },
]
const configurationCopy = {
  "claude-code": {
    title: "Configure Claude Code with repository settings",
    description: "Review the Claude Code settings, provider variants, hooks, permissions, and project guidance maintained in the repository.",
    intro: "This reference shows which Claude Code files to copy and what each file controls. Open the source before copying it so you can review every permission and environment value.",
    files: configurationDocuments.filter((file) => file.tool === "Claude Code"),
    source: ".claude/settings.json",
  },
  codex: {
    title: "Configure OpenAI Codex with repository settings",
    description: "Review the Codex CLI TOML configuration, provider variants, plugins, model settings, and shared repository guidance.",
    intro: "This reference maps each Codex configuration file to its purpose. Review the TOML source before placing it in your local Codex directory.",
    files: configurationDocuments.filter((file) => file.tool === "Codex CLI"),
    source: ".codex/config.toml",
  },
} as const
const providerCopy = {
  kimi: {
    label: "Kimi",
    title: "Configure Kimi for Claude Code and Codex",
    description: "Compare the repository-backed Kimi settings for Claude Code and OpenAI Codex, including each file’s source and target tool.",
    intro: "Use the Kimi provider files when you want the same model provider available in Claude Code and Codex. Review both formats because each tool expects different keys.",
  },
  minimax: {
    label: "MiniMax",
    title: "Configure MiniMax for Claude Code and Codex",
    description: "Compare the repository-backed MiniMax settings for Claude Code and OpenAI Codex, including each file’s source and target tool.",
    intro: "Use the MiniMax provider files to keep the provider choice consistent across Claude Code and Codex. Copy only the file for the tool you use.",
  },
  zai: {
    label: "Z.ai",
    title: "Configure Z.ai for Claude Code and Codex",
    description: "Compare the repository-backed Z.ai and GLM settings for Claude Code and OpenAI Codex, including each source file.",
    intro: "Use the Z.ai provider files when you want GLM models in Claude Code or Codex. Check the source because the JSON and TOML formats are not interchangeable.",
  },
} as const

let title = "Claude Settings"
let description = "Repository-backed settings, plugins, and agent skills."
let intro = description
let breadcrumbs = [homeCrumb]
let plugin: (typeof plugins)[number] | undefined
let skill: (typeof skills)[number] | undefined
let configuration: (typeof configurationCopy)[keyof typeof configurationCopy] | undefined
let provider: (typeof providerCopy)[keyof typeof providerCopy] | undefined

if (page.kind === "pluginHub") {
  title = "Find plugins for Claude Code, Codex, Cursor, and Gemini"
  description = `Explore ${plugins.length} repository-backed plugins with install commands, supported tools, included skills, and direct source links.`
  intro = "Search by task or filter by category. Each plugin page lists its skills, supported agents, and install commands."
  breadcrumbs = [homeCrumb, { label: "Plugins" }]
} else if (page.kind === "skillHub") {
  title = "Download agent skills for ChatGPT and Claude"
  description = `Download ${skills.length} agent skills as ZIP files for ChatGPT and Claude.ai, with compatibility, bundled-file, and setup labels.`
  intro = "Download a skill ZIP, review its source, then upload it to ChatGPT or Claude.ai. Every download is generated from the skill source in this repository."
  breadcrumbs = [homeCrumb, { label: "Skills" }]
} else if (page.kind === "settingsHub") {
  title = "Choose settings for Claude Code and Codex"
  description = "Find repository-backed Claude Code and OpenAI Codex settings, provider configurations, and CLAUDE.md guidance."
  intro = "Start with your coding agent, then choose a provider variant only if you need one. Every page links to the maintained repository file."
  breadcrumbs = [homeCrumb, { label: "Settings" }]
} else if (page.kind === "plugin") {
  plugin = pluginByName.get(page.plugin)
  if (!plugin) throw new Error(`Unknown plugin: ${page.plugin}`)
  title = plugin.seo.title
  description = plugin.description
  intro = plugin.description
  breadcrumbs = [homeCrumb, { label: "Plugins", href: "/plugins/" }, { label: plugin.name }]
} else if (page.kind === "skill") {
  skill = skillByKey.get(page.skill)
  if (!skill) throw new Error(`Unknown skill: ${page.skill}`)
  title = skill.seo.title
  description = skill.seo.description
  breadcrumbs = [
    homeCrumb,
    { label: "Plugins", href: "/plugins/" },
    { label: skill.plugin, href: `/plugins/${skill.plugin}/` },
    { label: skill.name },
  ]
} else if (page.kind === "configuration") {
  configuration = configurationCopy[page.configuration as keyof typeof configurationCopy]
  title = configuration.title
  description = configuration.description
  intro = configuration.intro
  breadcrumbs = [homeCrumb, { label: "Settings", href: "/settings/" }, { label: page.configuration }]
} else if (page.kind === "provider") {
  provider = providerCopy[page.provider as keyof typeof providerCopy]
  title = provider.title
  description = provider.description
  intro = provider.intro
  breadcrumbs = [
    homeCrumb,
    { label: "Settings", href: "/settings/" },
    { label: provider.label },
  ]
} else if (page.kind === "claudeGuide") {
  title = "Write a CLAUDE.md file for coding agents"
  description = "Use a maintained CLAUDE.md file as a reference for project rules, tool guidance, code style, and safe agent behavior."
  intro = "A CLAUDE.md file gives coding agents repository-specific instructions. Use this guide to choose rules that are concrete, testable, and relevant to the codebase."
  breadcrumbs = [homeCrumb, { label: "CLAUDE.md" }]
} else if (page.kind === "installGuide") {
  title = "Install agent skills and plugins in Claude, Codex, and Cursor"
  description = "Add the Claude Settings marketplace to Claude Code, OpenAI Codex, or Cursor, install plugins, and upload skill ZIPs to ChatGPT or Claude.ai."
  intro = "Pick your app. Coding agents install plugins from this marketplace. ChatGPT and Claude.ai take a skill ZIP."
  breadcrumbs = [homeCrumb, { label: "Install agent skills and plugins" }]
}

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    item: item.href ? new URL(item.href, site.url).href : canonical,
  })),
}
const graph: Record<string, unknown>[] = [breadcrumbSchema]
if (plugin) {
  graph.push({
    "@type": "SoftwareSourceCode",
    name: plugin.name,
    description: plugin.description,
    codeRepository: plugin.href,
    license: plugin.license,
    version: plugin.version,
  })
}
if (skill) {
  graph.push({
    "@type": "SoftwareSourceCode",
    name: skill.name,
    description,
    url: canonical,
    codeRepository: skill.sourceUrl,
    isPartOf: { "@type": "SoftwareSourceCode", name: skill.plugin, url: `${site.url}/plugins/${skill.plugin}/` },
  })
}
if (page.kind === "installGuide") {
  graph.push({
    "@type": "HowTo",
    name: title,
    description,
    step: [
      { "@type": "HowToStep", name: "Choose your app", text: "Pick Claude Code, Codex, Cursor, or Gemini CLI to install a plugin, or ChatGPT or Claude.ai to upload a skill ZIP." },
      { "@type": "HowToStep", name: "Add the marketplace", text: "Add the Claude Settings marketplace to Claude Code, OpenAI Codex, or Cursor." },
      { "@type": "HowToStep", name: "Install a plugin", text: "Install the plugin from the marketplace in your terminal or desktop app." },
      { "@type": "HowToStep", name: "Start a new session", text: "Start a new session, then ask the agent to use the installed skill or workflow." },
      { "@type": "HowToStep", name: "Upload a skill ZIP", text: "Download a skill ZIP without extracting it, then upload it to ChatGPT or Claude.ai." },
    ],
  })
}
const hubItems =
  page.kind === "pluginHub"
    ? plugins.map((item) => ({ name: item.name, href: `/plugins/${item.name}/` }))
    : page.kind === "skillHub"
      ? skills.map((item) => ({ name: item.name, href: item.detailUrl }))
      : []
if (hubItems.length) {
  graph.push({
    "@type": "ItemList",
    name: title,
    numberOfItems: hubItems.length,
    itemListElement: hubItems.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.name,
      url: new URL(item.href, site.url).href,
    })),
  })
}
const structuredData = { "@context": "https://schema.org", "@graph": graph }
const relatedSkills = skill?.seo.related.map((key) => {
  const related = skillByKey.get(key)
  if (!related) throw new Error(`Unknown related skill: ${key}`)
  return related
}) || []
const providerFiles = page.kind === "provider"
  ? configurationDocuments.filter((file) => file.provider === page.provider)
  : []
---

<Layout locale="en" variant="settings" {title} {description} {canonical} alternates={{ en: canonical }} {structuredData}>
  <article class="content-page" data-content-type={page.kind === "installGuide" ? "How-to" : page.kind.includes("Hub") ? "Landing" : "Reference"}>
    <Breadcrumbs items={breadcrumbs} />
    {plugin ? <PluginPage {plugin} /> : skill ? (
      <header class="catalog-hero">
        <div class="catalog-hero-copy">
          <DownloadCount count={skill.downloads} />
          <h1>{title}</h1>
          <p>{skill.seo.description}</p>
          <div class="skill-labels">
            <span>{skill.bundled.length ? `Includes ${skill.bundled.join(", ")}` : "Instructions only"}</span>
            {skill.externalSetup && <span>May require external tools</span>}
          </div>
          <div class="plugin-hero-links">
            <a class="official-link" href={skill.sourceUrl}>Read the skill instructions <Icon name="arrow" size={16} /></a>
            <a class="official-link" href={`/plugins/${skill.plugin}/`}>Included in {skill.plugin}</a>
          </div>
        </div>
        <aside class="catalog-install">
          <h2>Install this skill</h2>
          <InstallGuide {skill} />
        </aside>
      </header>
    ) : (
      <header class="content-hero">
        <h1>{title}</h1>
        <p>{intro}</p>
        {(page.kind === "skillHub" || page.kind === "pluginHub") && <DownloadCount count={downloadStats.total} />}
        {page.kind === "skillHub" && <a class="button primary" href="/guides/install-agent-skills/">Read the install guide <Icon name="arrow" size={18} /></a>}
      </header>
    )}

    {page.kind === "pluginHub" && <PluginHub />}

    {page.kind === "skillHub" && (
      <div class="content-sections">
        {skillGroups.map(([pluginName, pluginSkills]) => (
          <section class="catalog-section" id={pluginName}>
            {pluginSkills && pluginSkills.length > 1 && (
              <div class="section-heading">
                <h2><a href={`/plugins/${pluginName}/`}>{pluginByName.get(pluginName)?.seo.title}</a></h2>
                <span>{pluginSkills.length} skills</span>
              </div>
            )}
            <div class="skill-stack">{pluginSkills?.map((item) => <SkillDownload skill={item} heading={pluginSkills?.length === 1 ? "h2" : "h3"} compact />)}</div>
          </section>
        ))}
      </div>
    )}

    {page.kind === "settingsHub" && (
      <section class="content-section">
        <h2>Choose the file that matches your tool</h2>
        <p>Claude Code uses JSON settings. Codex uses TOML. Provider pages show both formats together.</p>
        <div class="reference-grid">
          {settingsCards.map((card) => <a class="reference-card" href={card.href}><h3>{card.title}</h3><p>{card.description}</p><span>Open reference <Icon name="arrow" size={16} /></span></a>)}
        </div>
      </section>
    )}

    {configuration && (
      <div class="content-sections">
        <section class="content-section">
          <h2>Review the default configuration</h2>
          <p>Clone the repository, open the source file, then merge only the values you need into your local configuration.</p>
          <pre class="code-sample"><code>{configuration.source}</code></pre>
        </section>
        <section class="content-section">
          <h2>Review each maintained file</h2>
          <p>The default file covers the standard setup. Provider variants change the model endpoint and related values.</p>
          <div class="file-list">
            {configuration.files.map((file) => <a href={file.url}><code>{file.path}</code><span>{file.provider ? `${file.provider} provider variant` : "Default configuration"}</span><Icon name="arrow" size={17} /></a>)}
          </div>
        </section>
      </div>
    )}

    {provider && (
      <div class="content-sections">
        <section class="content-section">
          <h2>Choose the format for your coding agent</h2>
          <p>Claude Code reads JSON. Codex reads TOML. Do not copy keys between the two formats.</p>
          <div class="file-list">
            {providerFiles.map((file) => <a href={file.url}><code>{file.path}</code><span>{file.tool}</span><Icon name="arrow" size={17} /></a>)}
          </div>
        </section>
        <section class="content-section related-links">
          <h2>Review the base configuration first</h2>
          <p>Start with the base settings page for your tool, then apply the provider file.</p>
          <a href="/settings/claude-code/">Claude Code settings</a>
          <a href="/settings/codex/">Codex settings</a>
        </section>
      </div>
    )}

    {skill && (
      <div class="content-sections">
        <section class="content-section">
          <h2>Related skills</h2>
          <div class="reference-grid">
            {relatedSkills.map((item) => (
              <a class="reference-card" href={item.detailUrl}>
                <h3>{item.seo.title}</h3>
                <p>{item.seo.description}</p>
              </a>
            ))}
          </div>
        </section>
      </div>
    )}

    {page.kind === "claudeGuide" && (
      <div class="content-sections">
        <section class="content-section">
          <h2>Put durable project rules in CLAUDE.md</h2>
          <p>Write rules that an agent can follow and verify. Include repository commands, file boundaries, code conventions, and safety limits.</p>
          <ul class="prose-list"><li>Name the exact command for tests and formatting</li><li>State which files are generated or must not change</li><li>Describe repository-specific naming and architecture</li><li>Remove guidance that duplicates tool defaults</li></ul>
        </section>
        <section class="content-section">
          <h2>Start from the maintained source</h2>
          <p>The repository file contains practical rules used across Claude Code and other coding agents. Copy only the parts that fit your project.</p>
          <a class="button secondary" href={`${repositoryUrl}/blob/main/.claude/CLAUDE.md`}>Open CLAUDE.md on GitHub <Icon name="arrow" size={18} /></a>
          <p class="source-size">Current source length: {sourceDocuments.claude.split("\n").length.toLocaleString("en")} lines</p>
        </section>
      </div>
    )}

    {page.kind === "installGuide" && <InstallGuide />}
  </article>
</Layout>
