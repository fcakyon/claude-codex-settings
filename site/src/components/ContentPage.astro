---
import Breadcrumbs from "./Breadcrumbs.astro"
import Icon, { type IconName } from "./Icon.astro"
import SkillDownload from "./SkillDownload.astro"
import Layout from "../layouts/Layout.astro"
import {
  codingTools,
  configurationDocuments,
  pluginByName,
  plugins,
  repositoryUrl,
  site,
  skills,
  sourceDocuments,
  type ContentPage,
} from "../lib/content"

interface Props {
  page: ContentPage
}

const { page } = Astro.props
const marketplaceCommands = Object.fromEntries(codingTools.map((tool) => [tool.id, tool.marketplace]))
const canonical = `${site.url}/${page.path}/`
const homeCrumb = { label: "Home", href: "/" }
const pluginCategories = Object.entries(Object.groupBy(plugins, (plugin) => plugin.category || "other")).sort(([a], [b]) =>
  a.localeCompare(b),
)
const skillGroups = Object.entries(Object.groupBy(skills, (skill) => skill.plugin)).sort(([a], [b]) => a.localeCompare(b))
const settingsCards = [
  {
    title: "Configure Claude Code",
    description: "Use the repository settings file, hooks, permissions, and environment layout for Claude Code.",
    href: "/settings/claude-code/",
  },
  {
    title: "Configure OpenAI Codex",
    description: "Use the repository TOML configuration, plugins, model settings, and project guidance for Codex.",
    href: "/settings/codex/",
  },
  {
    title: "Use Kimi models",
    description: "Compare the Claude Code and Codex files configured for Kimi models.",
    href: "/settings/providers/kimi/",
  },
  {
    title: "Use MiniMax models",
    description: "Compare the Claude Code and Codex files configured for MiniMax models.",
    href: "/settings/providers/minimax/",
  },
  {
    title: "Use Z.ai models",
    description: "Compare the Claude Code and Codex files configured for Z.ai and GLM models.",
    href: "/settings/providers/zai/",
  },
  {
    title: "Write a CLAUDE.md file",
    description: "Use the repository guidance file as a practical reference for agent instructions.",
    href: "/guides/claude-md/",
  },
]
const configurationCopy = {
  "claude-code": {
    title: "Configure Claude Code with repository settings",
    description: "Review the Claude Code settings, provider variants, hooks, permissions, and project guidance maintained in the repository.",
    intro: "This reference shows which Claude Code files to copy and what each file controls. Open the source before copying it so you can review every permission and environment value.",
    files: configurationDocuments.filter((file) => file.tool === "Claude Code"),
    source: ".claude/settings.json",
  },
  codex: {
    title: "Configure OpenAI Codex with repository settings",
    description: "Review the Codex CLI TOML configuration, provider variants, plugins, model settings, and shared repository guidance.",
    intro: "This reference maps each Codex configuration file to its purpose. Review the TOML source before placing it in your local Codex directory.",
    files: configurationDocuments.filter((file) => file.tool === "Codex CLI"),
    source: ".codex/config.toml",
  },
} as const
const providerCopy = {
  kimi: {
    label: "Kimi",
    title: "Configure Kimi for Claude Code and Codex",
    description: "Compare the repository-backed Kimi settings for Claude Code and OpenAI Codex, including each file’s source and target tool.",
    intro: "Use the Kimi provider files when you want the same model provider available in Claude Code and Codex. Review both formats because each tool expects different keys.",
  },
  minimax: {
    label: "MiniMax",
    title: "Configure MiniMax for Claude Code and Codex",
    description: "Compare the repository-backed MiniMax settings for Claude Code and OpenAI Codex, including each file’s source and target tool.",
    intro: "Use the MiniMax provider files to keep the provider choice consistent across Claude Code and Codex. Copy only the file for the tool you use.",
  },
  zai: {
    label: "Z.ai",
    title: "Configure Z.ai for Claude Code and Codex",
    description: "Compare the repository-backed Z.ai and GLM settings for Claude Code and OpenAI Codex, including each source file.",
    intro: "Use the Z.ai provider files when you want GLM models in Claude Code or Codex. Check the source because the JSON and TOML formats are not interchangeable.",
  },
} as const

let title = "Claude Settings"
let description = "Repository-backed settings, plugins, and agent skills."
let intro = description
let breadcrumbs = [homeCrumb]
let plugin: (typeof plugins)[number] | undefined
let skill: (typeof skills)[number] | undefined
let configuration: (typeof configurationCopy)[keyof typeof configurationCopy] | undefined
let provider: (typeof providerCopy)[keyof typeof providerCopy] | undefined

if (page.kind === "pluginHub") {
  title = "Find plugins for Claude Code, Codex, Cursor, and Gemini"
  description = `Explore ${plugins.length} repository-backed plugins with install commands, supported tools, included skills, and direct source links.`
  intro = "Choose a plugin by the job you need to complete. Each page lists its real components, supported coding agents, install commands, and downloadable skills."
  breadcrumbs = [homeCrumb, { label: "Plugins" }]
} else if (page.kind === "skillHub") {
  title = "Download agent skills for ChatGPT and Claude"
  description = `Download ${skills.length} agent skills as ZIP files for ChatGPT and Claude.ai, with compatibility, bundled-file, and setup labels.`
  intro = "Download a skill ZIP, review its source, then upload it to ChatGPT or Claude.ai. Every download is generated from the skill source in this repository."
  breadcrumbs = [homeCrumb, { label: "Skills" }]
} else if (page.kind === "settingsHub") {
  title = "Choose settings for Claude Code and Codex"
  description = "Find repository-backed Claude Code and OpenAI Codex settings, provider configurations, and CLAUDE.md guidance."
  intro = "Start with your coding agent, then choose a provider variant only if you need one. Every page links to the maintained repository file."
  breadcrumbs = [homeCrumb, { label: "Settings" }]
} else if (page.kind === "plugin") {
  plugin = pluginByName.get(page.plugin)
  if (!plugin) throw new Error(`Unknown plugin: ${page.plugin}`)
  title = `${plugin.name} plugin for AI coding agents`
  description = `${plugin.description} Review supported tools, install commands, components, source, and skill ZIP downloads.`
  intro = plugin.description
  breadcrumbs = [homeCrumb, { label: "Plugins", href: "/plugins/" }, { label: plugin.name }]
} else if (page.kind === "skill") {
  skill = skills.find((item) => item.key === page.skill)
  if (!skill?.seo) throw new Error(`Unknown SEO skill: ${page.skill}`)
  title = skill.seo.title
  description = skill.seo.description
  intro = skill.seo.intro
  breadcrumbs = [
    homeCrumb,
    { label: "Plugins", href: "/plugins/" },
    { label: skill.plugin, href: `/plugins/${skill.plugin}/` },
    { label: skill.name },
  ]
} else if (page.kind === "configuration") {
  configuration = configurationCopy[page.configuration as keyof typeof configurationCopy]
  title = configuration.title
  description = configuration.description
  intro = configuration.intro
  breadcrumbs = [homeCrumb, { label: "Settings", href: "/settings/" }, { label: page.configuration }]
} else if (page.kind === "provider") {
  provider = providerCopy[page.provider as keyof typeof providerCopy]
  title = provider.title
  description = provider.description
  intro = provider.intro
  breadcrumbs = [
    homeCrumb,
    { label: "Settings", href: "/settings/" },
    { label: provider.label },
  ]
} else if (page.kind === "claudeGuide") {
  title = "Write a CLAUDE.md file for coding agents"
  description = "Use a maintained CLAUDE.md file as a reference for project rules, tool guidance, code style, and safe agent behavior."
  intro = "A CLAUDE.md file gives coding agents repository-specific instructions. Use this guide to choose rules that are concrete, testable, and relevant to the codebase."
  breadcrumbs = [homeCrumb, { label: "CLAUDE.md" }]
} else if (page.kind === "installGuide") {
  title = "Install agent skills and plugins in Claude, Codex, and Cursor"
  description = "Add the Claude Settings marketplace to Claude Code, OpenAI Codex, or Cursor, install plugins, and upload skill ZIPs to ChatGPT or Claude.ai."
  intro = "Use plugin marketplaces with coding agents. Upload a skill ZIP when you work in ChatGPT or Claude.ai. This guide covers both paths and how to use what you install."
  breadcrumbs = [homeCrumb, { label: "Install agent skills and plugins" }]
}

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    item: item.href ? new URL(item.href, site.url).href : canonical,
  })),
}
const graph: Record<string, unknown>[] = [breadcrumbSchema]
if (plugin) {
  graph.push({
    "@type": "SoftwareSourceCode",
    name: plugin.name,
    description: plugin.description,
    codeRepository: plugin.href,
    license: plugin.license,
    version: plugin.version,
  })
}
if (page.kind === "installGuide") {
  graph.push({
    "@type": "HowTo",
    name: title,
    description,
    step: [
      { "@type": "HowToStep", name: "Choose the installation path", text: "Install a plugin in a coding agent, or upload a skill ZIP to ChatGPT or Claude.ai." },
      { "@type": "HowToStep", name: "Add the marketplace", text: "Add the Claude Settings marketplace to Claude Code, OpenAI Codex, or Cursor." },
      { "@type": "HowToStep", name: "Install a plugin", text: "Install the plugin from the marketplace in your terminal or desktop app." },
      { "@type": "HowToStep", name: "Start a new session", text: "Start a new session, then ask the agent to use the installed skill or workflow." },
      { "@type": "HowToStep", name: "Upload a skill ZIP", text: "Download a skill ZIP without extracting it, then upload it to ChatGPT or Claude.ai." },
    ],
  })
}
const structuredData = { "@context": "https://schema.org", "@graph": graph }
const providerFiles = page.kind === "provider"
  ? configurationDocuments.filter((file) => file.provider === page.provider)
  : []
const pluginSkills = plugin ? skills.filter((item) => item.plugin === plugin.name) : []
const codingToolIcons = new Map(codingTools.map(({ id, icon }) => [id, icon]))
const installDemoCommands = plugin?.installCommands.map((item) => ({
  ...item,
  icon: codingToolIcons.get(item.id) as IconName,
})) || []
const initialInstallDemo = installDemoCommands[0]
---

<Layout locale="en" variant="settings" {title} {description} {canonical} alternates={{ en: canonical }} {structuredData}>
  <article class="content-page" data-content-type={page.kind === "installGuide" ? "How-to" : page.kind.includes("Hub") ? "Landing" : "Reference"}>
    <Breadcrumbs items={breadcrumbs} />
    <header class="content-hero">
      <h1>{title}</h1>
      <p>{intro}</p>
      {page.kind === "skillHub" && <a class="button primary" href="/guides/install-agent-skills/">Read the install guide <Icon name="arrow" size={18} /></a>}
      {page.kind === "pluginHub" && <a class="button secondary" href="https://agentplugins.net">Search the compact directory <Icon name="arrow" size={18} /></a>}
    </header>

    {page.kind === "pluginHub" && (
      <div class="content-sections">
        {pluginCategories.map(([category, categoryPlugins]) => (
          <section class="catalog-section">
            <div class="section-heading"><h2>{category.replaceAll("-", " ")}</h2><span>{categoryPlugins?.length || 0} plugins</span></div>
            <div class="catalog-list">
              {categoryPlugins?.map((item) => (
                <a class="catalog-row" href={`/plugins/${item.name}/`}>
                  <strong>{item.name}</strong><span>{item.description}</span><small>{item.tools.join(" · ")}</small><Icon name="arrow" size={18} />
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    )}

    {page.kind === "skillHub" && (
      <div class="content-sections">
        {skillGroups.map(([pluginName, pluginSkills]) => (
          <section class="catalog-section" id={pluginName}>
            <div class="section-heading">
              <h2><a href={`/plugins/${pluginName}/`}>{pluginName}</a></h2>
              <span>{pluginSkills?.length || 0} skills</span>
            </div>
            <div class="skill-stack">{pluginSkills?.map((item) => <SkillDownload skill={item} heading="h3" compact />)}</div>
          </section>
        ))}
      </div>
    )}

    {page.kind === "settingsHub" && (
      <section class="content-section">
        <h2>Choose the file that matches your tool</h2>
        <p>Claude Code uses JSON settings. Codex uses TOML. Provider pages show both formats together.</p>
        <div class="reference-grid">
          {settingsCards.map((card) => <a class="reference-card" href={card.href}><h3>{card.title}</h3><p>{card.description}</p><span>Open reference <Icon name="arrow" size={16} /></span></a>)}
        </div>
      </section>
    )}

    {configuration && (
      <div class="content-sections">
        <section class="content-section">
          <h2>Review the default configuration</h2>
          <p>Clone the repository, open the source file, then merge only the values you need into your local configuration.</p>
          <pre class="code-sample"><code>{configuration.source}</code></pre>
        </section>
        <section class="content-section">
          <h2>Review each maintained file</h2>
          <p>The default file covers the standard setup. Provider variants change the model endpoint and related values.</p>
          <div class="file-list">
            {configuration.files.map((file) => <a href={file.url}><code>{file.path}</code><span>{file.provider ? `${file.provider} provider variant` : "Default configuration"}</span><Icon name="arrow" size={17} /></a>)}
          </div>
        </section>
      </div>
    )}

    {provider && (
      <div class="content-sections">
        <section class="content-section">
          <h2>Choose the format for your coding agent</h2>
          <p>Claude Code reads JSON. Codex reads TOML. Do not copy keys between the two formats.</p>
          <div class="file-list">
            {providerFiles.map((file) => <a href={file.url}><code>{file.path}</code><span>{file.tool}</span><Icon name="arrow" size={17} /></a>)}
          </div>
        </section>
        <section class="content-section related-links">
          <h2>Review the base configuration first</h2>
          <p>Start with the base settings page for your tool, then apply the provider file.</p>
          <a href="/settings/claude-code/">Claude Code settings</a>
          <a href="/settings/codex/">Codex settings</a>
        </section>
      </div>
    )}

    {plugin && (
      <div class="content-sections">
        <section class="content-section install-terminal-section" data-install-terminal>
          <h2>Install the plugin in your coding agent</h2>
          <p><a class="inline-link" href="/guides/install-agent-skills/#coding-agent-plugins">Add the marketplace once</a>, then run the command for your tool.</p>
          <div class="install-tool-tabs" role="tablist" aria-label="Choose a coding agent">
            {installDemoCommands.map(({ tool, command, icon, output }, index) => (
              <button
                id={`install-tab-${plugin.name}-${index}`}
                class:list={["install-tool-tab", { "is-active": index === 0 }]}
                type="button"
                role="tab"
                aria-controls={`install-terminal-${plugin.name}`}
                aria-selected={index === 0 ? "true" : "false"}
                tabindex={index === 0 ? 0 : -1}
                data-install-tab
                data-command={command}
                data-output-primary={output[0]}
                data-output-secondary={output[1]}
              >
                <Icon name={icon} size={22} />
                <span>{tool}</span>
              </button>
            ))}
          </div>
          <div
            id={`install-terminal-${plugin.name}`}
            class="install-terminal"
            role="tabpanel"
            aria-labelledby={`install-tab-${plugin.name}-0`}
            data-install-panel
          >
            <div class="install-terminal-bar">
              <span class="terminal-lights" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="install-terminal-title">Terminal · <strong data-install-title>{initialInstallDemo.tool}</strong></span>
              <button class="terminal-copy" type="button" data-copy={initialInstallDemo.command} aria-label={`Copy ${initialInstallDemo.tool} install command`}>
                <Icon name="copy" size={18} />
                <span data-install-copy-label>Copy command</span>
              </button>
            </div>
            <div class="install-terminal-body">
              <div class="install-command-line">
                <span class="install-prompt" aria-hidden="true">$</span>
                <code data-install-command>{initialInstallDemo.command}</code>
                <span class="typing-cursor" aria-hidden="true"></span>
              </div>
              <div class="install-output" aria-hidden="true">
                <p data-install-output-primary>{initialInstallDemo.output[0]}</p>
                <p class="install-success" data-install-output-secondary>{initialInstallDemo.output[1]}</p>
              </div>
              <span class="sr-only" aria-live="polite" data-install-announcement></span>
            </div>
            <div class="install-terminal-progress">
              <span class="install-progress-track" aria-hidden="true"><i data-install-progress></i></span>
              <span data-install-count>1 of {installDemoCommands.length}</span>
              <button type="button" data-install-toggle aria-label="Pause installation demo" title="Pause installation demo">
                <span class="pause-glyph"><Icon name="pause" size={16} /></span>
                <span class="play-glyph"><Icon name="play" size={16} /></span>
              </button>
            </div>
          </div>
        </section>
        <section class="content-section">
          <h2>See what the plugin includes</h2>
          <p>These components come from the current plugin directory, not a hand-written feature list.</p>
          <dl class="component-list">
            <div><dt>Supported tools</dt><dd>{plugin.tools.join(", ")}</dd></div>
            <div><dt>Skills</dt><dd>{plugin.components?.skills.join(", ") || "None"}</dd></div>
            <div><dt>Agents</dt><dd>{plugin.components?.agents.join(", ") || "None"}</dd></div>
            <div><dt>Commands</dt><dd>{plugin.components?.commands.join(", ") || "None"}</dd></div>
            <div><dt>Hooks</dt><dd>{plugin.components?.hooks ? "Included" : "None"}</dd></div>
          </dl>
        </section>
        {pluginSkills.length > 0 && (
          <section class="content-section">
            <h2>Download this plugin’s skills</h2>
            <p>Each release ZIP works in ChatGPT and Claude.ai. Review the source before uploading it.</p>
            <div class="skill-stack">{pluginSkills.map((item) => <SkillDownload skill={item} heading="h3" />)}</div>
          </section>
        )}
        <section class="content-section source-facts">
          <h2>Verify the source</h2>
          <p>Version {plugin.version}. License: {plugin.license || "See source"}.</p>
          <a class="text-link" href={plugin.href}>Open the plugin files on GitHub <Icon name="arrow" size={17} /></a>
        </section>
      </div>
    )}

    {skill && (
      <div class="content-sections">
        <section class="content-section"><SkillDownload {skill} /></section>
        <section class="content-section">
          <h2>Use the skill for the right task</h2>
          <p>{skill.description}</p>
          <p>The skill belongs to the <a class="inline-link" href={`/plugins/${skill.plugin}/`}><code>{skill.plugin}</code> plugin</a>. Install the full plugin for coding-agent commands, hooks, or related skills.</p>
        </section>
      </div>
    )}

    {page.kind === "claudeGuide" && (
      <div class="content-sections">
        <section class="content-section">
          <h2>Put durable project rules in CLAUDE.md</h2>
          <p>Write rules that an agent can follow and verify. Include repository commands, file boundaries, code conventions, and safety limits.</p>
          <ul class="prose-list"><li>Name the exact command for tests and formatting</li><li>State which files are generated or must not change</li><li>Describe repository-specific naming and architecture</li><li>Remove guidance that duplicates tool defaults</li></ul>
        </section>
        <section class="content-section">
          <h2>Start from the maintained source</h2>
          <p>The repository file contains practical rules used across Claude Code and other coding agents. Copy only the parts that fit your project.</p>
          <a class="button secondary" href={`${repositoryUrl}/blob/main/.claude/CLAUDE.md`}>Open CLAUDE.md on GitHub <Icon name="arrow" size={18} /></a>
          <p class="source-size">Current source length: {sourceDocuments.claude.split("\n").length.toLocaleString("en")} lines</p>
        </section>
      </div>
    )}

    {page.kind === "installGuide" && (
      <div class="content-sections install-guide">
        <section class="content-section" id="choose-installation-path">
          <h2>Choose the installation path for your app</h2>
          <p>Install a plugin when you use a coding agent. Upload a ZIP when you use Skills in ChatGPT or Claude.ai.</p>
          <div class="reference-grid">
            <a class="reference-card" href="#coding-agent-plugins"><h3>Claude Code, Codex, Cursor, and Gemini CLI</h3><p>Add the marketplace where supported, or install a local Gemini extension.</p><span>Install coding-agent plugins <Icon name="arrow" size={16} /></span></a>
            <a class="reference-card" href="#web-skill-uploads"><h3>ChatGPT and Claude.ai</h3><p>Download one skill as a ZIP, then upload it through the Skills interface.</p><span>Upload a skill ZIP <Icon name="arrow" size={16} /></span></a>
          </div>
        </section>
        <section class="content-section" id="coding-agent-plugins">
          <h2>Add this marketplace to Claude Code</h2>
          <p>Claude Code uses the same configured marketplaces in the terminal and desktop app for local sessions.</p>
          <p>From the terminal, add the marketplace once, then install each plugin by name.</p>
          <pre class="code-sample"><code>{`${marketplaceCommands.claude}
claude plugin install simplify@claude-settings`}</code></pre>
          <p>In Claude Code desktop, select <strong>+</strong> beside the prompt, then <strong>Plugins</strong> and <strong>Add plugin</strong>. Choose a plugin from the configured marketplace.</p>
          <p>Run <code>/reload-plugins</code> after an install in an open session. New sessions load installed plugins automatically.</p>
          <a class="official-link" href="https://code.claude.com/docs/en/discover-plugins">Read the official Claude Code plugin guide</a>
        </section>
        <section class="content-section">
          <h2>Add this marketplace to OpenAI Codex</h2>
          <p>Codex supports this marketplace in the terminal and the Codex desktop app. The Codex IDE extension doesn’t support plugins.</p>
          <p>From the terminal, add the marketplace once, then install each plugin by name.</p>
          <pre class="code-sample"><code>{`${marketplaceCommands.codex}
codex plugin add simplify@claude-settings`}</code></pre>
          <p>Enter <code>/plugins</code> in Codex CLI to browse configured marketplaces interactively. Start a new session after installing a plugin.</p>
          <p>In the Codex desktop app, open <strong>Plugins</strong>, find the plugin, and select <strong>Install</strong>. Start a new task before you use its skills or tools.</p>
          <a class="official-link" href="https://learn.chatgpt.com/docs/plugins">Read the official OpenAI plugin guide</a>
        </section>
        <section class="content-section">
          <h2>Add this marketplace to Cursor</h2>
          <p>Cursor installs personal plugins interactively. User-scope plugins work in the Cursor app and Cursor Agent CLI.</p>
          <p>From the terminal, add the repository and start Cursor Agent. Enter <code>/plugin</code> to choose and install a plugin.</p>
          <pre class="code-sample"><code>{`${marketplaceCommands.cursor}
cursor-agent`}</code></pre>
          <p>In the Cursor app, open <strong>Customize</strong>, find the plugin, and select <strong>Install</strong>. Choose user or project scope when prompted.</p>
          <p>The marketplace command only adds the catalog.</p>
          <a class="official-link" href="https://cursor.com/docs/plugins">Read the official Cursor plugin guide</a>
        </section>
        <section class="content-section">
          <h2>Install a local extension in Gemini CLI</h2>
          <p>Gemini CLI installs extensions from local plugin folders. Clone the repository, then run the extension command from its root.</p>
          <pre class="code-sample"><code>{`git clone ${repositoryUrl}.git
cd claude-codex-settings
gemini extensions install --path ./plugins/simplify`}</code></pre>
          <p>Replace <code>simplify</code> with the plugin you want. Start a new Gemini CLI session after installation.</p>
          <a class="official-link" href="https://geminicli.com/docs/extensions/reference/">Read the official Gemini CLI extension reference</a>
        </section>
        <section class="content-section">
          <h2>Use an installed plugin in a new session</h2>
          <p>Start a new session so the agent loads the plugin. Describe the task or name the skill in your prompt.</p>
          <pre class="code-sample"><code>{`Use the simplify skill to review my staged diff.
Use the humanize skill to revise this README.`}</code></pre>
          <p>Some plugins also add slash commands. Open the <a class="inline-link" href="/plugins/">plugin catalog</a> to see each plugin’s components and install commands.</p>
        </section>
        <section class="content-section" id="web-skill-uploads">
          <h2>Choose and review a skill</h2>
          <p>Open the source before uploading code from any publisher. Check <code>SKILL.md</code>, scripts, references, and external tool requirements.</p>
          <a class="button secondary" href="/skills/">Browse all skill downloads <Icon name="arrow" size={18} /></a>
        </section>
        <section class="content-section">
          <h2>Upload a skill to ChatGPT</h2>
          <p>Personal Skills are available on eligible ChatGPT plans. Workspace administrators can control skill uploads.</p>
          <figure class="tutorial-figure">
            <img src="/tutorials/install-skill-chatgpt.webp" alt="Live ChatGPT interface showing the Skills page, upload menu, and ZIP upload screen" width="1200" height="760" loading="lazy" />
            <figcaption>Current ChatGPT Skills upload flow, recorded from the live interface.</figcaption>
          </figure>
