---
import Breadcrumbs from "./Breadcrumbs.astro"
import InstallGuide from "./InstallGuide.astro"
import CatalogHub from "./CatalogHub.astro"
import PluginPage from "./PluginPage.astro"
import Icon from "./Icon.astro"
import DownloadCount from "./DownloadCount.astro"
import SourceFile from "./SourceFile.astro"
import Layout from "../layouts/Layout.astro"
import {
  claudeGuideFile,
  configurationDocuments,
  downloadStats,
  pluginByName,
  plugins,
  popularSkills,
  providerLabels,
  site,
  skills,
  skillByKey,
  type ContentPage,
} from "../lib/content"

interface Props {
  page: ContentPage
}

const { page } = Astro.props
const canonical = `${site.url}/${page.path}/`
const homeCrumb = { label: "Home", href: "/" }
const settingsCards = [
  {
    title: "Configure Claude Code",
    description: "The settings.json with permissions, hooks, environment variables and enabled plugins.",
    href: "/settings/claude-code/",
  },
  {
    title: "Configure OpenAI Codex",
    description: "The config.toml with model, reasoning, plugin and project settings.",
    href: "/settings/codex/",
  },
  {
    title: "Use Kimi models",
    description: "Claude Code and Codex files that point both tools at Kimi.",
    href: "/settings/providers/kimi/",
  },
  {
    title: "Use MiniMax models",
    description: "Claude Code and Codex files that point both tools at MiniMax.",
    href: "/settings/providers/minimax/",
  },
  {
    title: "Use Z.ai models",
    description: "Claude Code and Codex files for Z.ai GLM models.",
    href: "/settings/providers/zai/",
  },
  {
    title: "Write a CLAUDE.md file",
    description: "The rules file this repository uses, as a starting point for yours.",
    href: "/guides/claude-md/",
  },
]
const configurationCopy = {
  "claude-code": {
    title: "Claude Code settings.json with hooks and permissions",
    description: "Copy a working Claude Code settings.json with permissions, hooks, environment variables and plugins, plus Kimi, MiniMax and Z.ai variants.",
    intro: "This is the settings.json from the repository. Check each permission and hook before you merge it into ~/.claude/settings.json.",
    tool: "Claude Code",
  },
  codex: {
    title: "Codex config.toml with plugins and model settings",
    description: "Copy a working OpenAI Codex config.toml with model, reasoning, plugin and project settings, plus Kimi, MiniMax and Z.ai variants.",
    intro: "This is the config.toml from the repository. Merge the parts you need into ~/.codex/config.toml.",
    tool: "Codex CLI",
  },
} as const
const providerCopy = {
  kimi: {
    title: "Configure Kimi for Claude Code and Codex",
    description: "Copy the Kimi settings for Claude Code and OpenAI Codex. Claude Code reads the JSON file and Codex reads the TOML file with its proxy setup.",
    intro: "Use these files to run Kimi models in Claude Code and Codex. Each tool expects different keys, so copy the file for your tool.",
  },
  minimax: {
    title: "Configure MiniMax for Claude Code and Codex",
    description: "Copy the MiniMax settings for Claude Code and OpenAI Codex, with the model names and endpoints each tool needs in its own file format.",
    intro: "Use these files to run MiniMax models in Claude Code and Codex. Copy only the file for the tool you use.",
  },
  zai: {
    title: "Configure Z.ai for Claude Code and Codex",
    description: "Copy the Z.ai GLM settings for Claude Code and OpenAI Codex. The JSON and TOML files use different keys, so take the one for your tool.",
    intro: "Use these files to run Z.ai GLM models in Claude Code or Codex. The JSON and TOML formats are not interchangeable.",
  },
} as const

let title: string
let description: string
let intro = ""
let breadcrumbs = [homeCrumb]
let plugin: (typeof plugins)[number] | undefined
let skill: (typeof skills)[number] | undefined
let configuration: (typeof configurationCopy)[keyof typeof configurationCopy] | undefined
let provider: (typeof providerCopy)[keyof typeof providerCopy] | undefined

if (page.kind === "pluginHub") {
  title = "Find plugins for Claude Code, Codex, Cursor, and Gemini"
  description = `${plugins.length} plugins for Claude Code, Codex, Cursor and Gemini CLI. See what each one adds, which tools it supports and how to install it.`
  intro = `${plugins.length} plugins with ${skills.length} skills, plus hooks and agents. Filter by category or search for a task.`
  breadcrumbs = [homeCrumb, { label: "Plugins" }]
} else if (page.kind === "skillHub") {
  title = "Download agent skills for ChatGPT and Claude"
  description = `Download any of ${skills.length} agent skills as a ZIP and upload it to ChatGPT or Claude.ai. Each skill page lists its files and when it runs.`
  intro = "Search by task, download the ZIP, then upload it to ChatGPT or Claude.ai."
  breadcrumbs = [homeCrumb, { label: "Skills" }]
} else if (page.kind === "settingsHub") {
  title = "Choose settings for Claude Code and Codex"
  description = "Copy Claude Code and OpenAI Codex settings files, including Kimi, MiniMax and Z.ai provider variants and a CLAUDE.md you can adapt."
  intro = "Start with the file for your agent. Add a provider variant only if you use Kimi, MiniMax or Z.ai models."
  breadcrumbs = [homeCrumb, { label: "Settings" }]
} else if (page.kind === "plugin") {
  plugin = pluginByName.get(page.plugin)
  if (!plugin) throw new Error(`Unknown plugin: ${page.plugin}`)
  title = plugin.seo.title
  description = plugin.description
  breadcrumbs = [homeCrumb, { label: "Plugins", href: "/plugins/" }, { label: plugin.name }]
} else if (page.kind === "skill") {
  skill = skillByKey.get(page.skill)
  if (!skill) throw new Error(`Unknown skill: ${page.skill}`)
  title = skill.seo.title
  description = skill.seo.description
  breadcrumbs = [
    homeCrumb,
    { label: "Plugins", href: "/plugins/" },
    { label: skill.plugin, href: `/plugins/${skill.plugin}/` },
    { label: `${skill.name} skill` },
  ]
} else if (page.kind === "configuration") {
  configuration = configurationCopy[page.configuration as keyof typeof configurationCopy]
  title = configuration.title
  description = configuration.description
  intro = configuration.intro
  breadcrumbs = [homeCrumb, { label: "Settings", href: "/settings/" }, { label: configuration.tool }]
} else if (page.kind === "provider") {
  provider = providerCopy[page.provider as keyof typeof providerCopy]
  title = provider.title
  description = provider.description
  intro = provider.intro
  breadcrumbs = [homeCrumb, { label: "Settings", href: "/settings/" }, { label: providerLabels[page.provider] }]
} else if (page.kind === "claudeGuide") {
  title = "Write a CLAUDE.md file for coding agents"
  description = "Use a maintained CLAUDE.md file as a reference for project rules, tool guidance, code style, and safe agent behavior."
  intro = "A CLAUDE.md file gives coding agents the rules of your repository. Keep each rule concrete, testable and specific to the codebase."
  breadcrumbs = [homeCrumb, { label: "CLAUDE.md" }]
} else {
  title = "Install agent skills and plugins in Claude, Codex, and Cursor"
  description = "Add the Claude Settings marketplace to Claude Code, OpenAI Codex, or Cursor, install plugins, and upload skill ZIPs to ChatGPT or Claude.ai."
  intro = "Pick your app. Coding agents install plugins from this marketplace. ChatGPT and Claude.ai take a skill ZIP."
  breadcrumbs = [homeCrumb, { label: "Install agent skills and plugins" }]
}

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    item: item.href ? new URL(item.href, site.url).href : canonical,
  })),
}
const graph: Record<string, unknown>[] = [breadcrumbSchema]
if (plugin) {
  graph.push({
    "@type": "SoftwareSourceCode",
    name: plugin.name,
    description: plugin.description,
    url: canonical,
    codeRepository: plugin.href,
    license: plugin.license,
    version: plugin.version,
  })
}
if (skill) {
  graph.push({
    "@type": "SoftwareSourceCode",
    name: skill.name,
    description,
    url: canonical,
    codeRepository: skill.sourceUrl,
    isPartOf: { "@type": "SoftwareSourceCode", name: skill.plugin, url: `${site.url}/plugins/${skill.plugin}/` },
  })
}
const hubItems =
  page.kind === "pluginHub"
    ? plugins.map((item) => ({ name: item.name, href: `/plugins/${item.name}/` }))
    : page.kind === "skillHub"
      ? popularSkills.map((item) => ({ name: item.name, href: item.detailUrl }))
      : []
if (hubItems.length) {
  graph.push({
    "@type": "ItemList",
    name: title,
    numberOfItems: hubItems.length,
    itemListElement: hubItems.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.name,
      url: new URL(item.href, site.url).href,
    })),
  })
}
const structuredData = { "@context": "https://schema.org", "@graph": graph }
const relatedSkills = skill?.seo.related.map((key) => {
  const related = skillByKey.get(key)
  if (!related) throw new Error(`Unknown related skill: ${key}`)
  return related
}) || []
const [configurationFile, ...variantFiles] = configuration ? configurationDocuments.filter((file) => file.tool === configuration.tool) : []
const providerFiles = page.kind === "provider" ? configurationDocuments.filter((file) => file.provider === page.provider) : []
const claudeFile = page.kind === "claudeGuide" ? claudeGuideFile : undefined
---

<Layout locale="en" variant="settings" {title} {description} {canonical} alternates={{ en: canonical }} {structuredData}>
  <article class="content-page" data-content-type={page.kind === "installGuide" ? "How-to" : page.kind.includes("Hub") ? "Landing" : "Reference"}>
    <Breadcrumbs items={breadcrumbs} />
    {plugin ? <PluginPage {plugin} /> : skill ? (
      <header class="catalog-hero">
        <div class="catalog-hero-copy">
          <DownloadCount count={skill.downloads} />
          <h1>{title}</h1>
          <p>{skill.seo.description}</p>
          <div class="hero-links">
            <a class="official-link" href={`/plugins/${skill.plugin}/`}>Part of the {skill.plugin} plugin</a>
            <a class="official-link" href={skill.sourceUrl}>Source on GitHub</a>
          </div>
        </div>
        <aside class="catalog-install">
          <h2>Install {skill.name}</h2>
          <InstallGuide {skill} />
        </aside>
      </header>
    ) : (
      <header class="content-hero">
        <h1>{title}</h1>
        <p>{intro}</p>
        {(page.kind === "skillHub" || page.kind === "pluginHub") && <DownloadCount count={downloadStats.total} />}
        {page.kind === "skillHub" && <a class="button secondary" href="/guides/install-agent-skills/#chatgpt">How to upload a skill</a>}
      </header>
    )}

    {page.kind === "pluginHub" && <CatalogHub kind="plugin" />}
    {page.kind === "skillHub" && <CatalogHub kind="skill" />}

    {page.kind === "settingsHub" && (
      <div class="reference-grid">
        {settingsCards.map((card) => <a class="reference-card" href={card.href}><h2>{card.title}</h2><p>{card.description}</p></a>)}
      </div>
    )}

    {configurationFile && (
      <div class="content-sections">
        <section class="content-section">
          <SourceFile file={configurationFile} />
        </section>
        <section class="content-section">
          <h2>Provider variants</h2>
          <p>Each variant swaps the model provider and the values that go with it.</p>
          <div class="file-list">
            {variantFiles.map((file) => <a href={`/settings/providers/${file.provider}/`}><code>{file.path}</code><span>{providerLabels[file.provider!]}</span><Icon name="chevron" size={17} /></a>)}
          </div>
        </section>
      </div>
    )}

    {provider && (
      <div class="content-sections">
        {providerFiles.map((file) => (
          <section class="content-section">
            <SourceFile {file} />
          </section>
        ))}
        <section class="content-section related-links">
          <h2>Start from the base settings</h2>
          <p>The base files carry the permissions, hooks and plugins that the provider files build on.</p>
          <a href="/settings/claude-code/">Claude Code settings.json</a>
          <a href="/settings/codex/">Codex config.toml</a>
        </section>
      </div>
    )}

    {skill && (
      <div class="content-sections">
        <section class="content-section">
          <h2>When it runs</h2>
          <p>Your agent reads this description from <code>SKILL.md</code> to decide when to load the skill:</p>
          <blockquote class="skill-trigger">{skill.trigger}</blockquote>
        </section>
        {skill.sections.length > 0 && (
          <section class="content-section">
            <h2>What SKILL.md covers</h2>
            <ul class="skill-sections">{skill.sections.map((section) => <li>{section}</li>)}</ul>
          </section>
        )}
        <section class="content-section">
          <h2>Files in the ZIP</h2>
          <ul class="skill-files">
            {skill.files.map((file) => <li><a href={file.url}><Icon name="file" size={16} /><code>{skill.name}/{file.path}</code></a></li>)}
          </ul>
        </section>
        <section class="content-section">
          <h2>Related skills</h2>
          <div class="reference-grid">
            {relatedSkills.map((item) => (
              <a class="reference-card" href={item.detailUrl}>
                <h3>{item.seo.title}</h3>
                <p>{item.seo.description}</p>
              </a>
            ))}
          </div>
        </section>
      </div>
    )}

    {claudeFile && (
      <div class="content-sections">
        <section class="content-section">
          <h2>Put durable project rules in CLAUDE.md</h2>
          <p>Write rules that an agent can follow and check. Include repository commands, file boundaries, code conventions and safety limits.</p>
          <ul class="prose-list"><li>Name the exact command for tests and formatting</li><li>State which files are generated or must not change</li><li>Describe repository-specific naming and architecture</li><li>Remove guidance that duplicates tool defaults</li></ul>
        </section>
        <section class="content-section">
          <h2>The CLAUDE.md this repository uses</h2>
          <p>Copy only the rules that fit your project.</p>
          <SourceFile file={claudeFile} />
        </section>
      </div>
    )}

    {page.kind === "installGuide" && <InstallGuide />}
  </article>
</Layout>
