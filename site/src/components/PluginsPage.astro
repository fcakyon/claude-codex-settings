---
import Icon from "./Icon.astro"
import PluginDirectory from "./PluginDirectory.astro"
import { translations, type Locale } from "../lib/i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = translations[locale].plugins
const tools = [
  ["claude", "Claude Code"],
  ["openai", "Codex CLI"],
  ["cursor", "Cursor"],
  ["gemini", "Gemini CLI"],
] as const
---

<section class="plugins-hero">
  <div class="plugins-intro">
    <h1>{copy.hero.title}</h1>
    <p>{copy.hero.description}</p>
  </div>
  <PluginDirectory locale={locale} />
</section>

<section class="section compatibility" id="compatibility">
  <div class="section-intro">
    <h2>{copy.compatibility.title}</h2>
    <p>{copy.compatibility.description}</p>
  </div>
  <div class="compatibility-rail">
    {tools.map(([icon, label], index) => (
      <div><Icon name={icon} size={26} /><strong>{label}</strong><span>{copy.compatibility.tools[index]}</span></div>
    ))}
  </div>
</section>
