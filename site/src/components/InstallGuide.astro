---
import Icon from "./Icon.astro"
import { codingTools, pluginByName, repositoryUrl, type Plugin, type Skill } from "../lib/content"

interface Props {
  plugin?: Plugin
  skill?: Skill
}

const { plugin, skill } = Astro.props
const compact = Boolean(plugin || skill)
const target = plugin || pluginByName.get(skill?.plugin || "simplify")!

const marketplaceCommands = Object.fromEntries(codingTools.map((tool) => [tool.id, tool.marketplace]))
const guideTabs = [
  {
    id: "claude-code",
    aliases: ["coding-agent-plugins"],
    label: "Claude Code",
    icon: "claude",
    title: "Add this marketplace to Claude Code",
    intro: "Add the marketplace once, then install plugins by name. The terminal and desktop app share it.",
    code: `${marketplaceCommands.claude}\n${target.claudeCommand}`,
    note: "In an open session, run <code>/reload-plugins</code>.",
    app: "Select <strong>+</strong> beside the prompt, then <strong>Plugins</strong> and <strong>Add plugin</strong>.",
    docs: ["Claude Code plugin docs", "https://code.claude.com/docs/en/discover-plugins"],
  },
  {
    id: "codex",
    label: "Codex",
    icon: "openai",
    title: "Add this marketplace to OpenAI Codex",
    intro: "Plugins work in the Codex CLI and desktop app, not in the IDE extension.",
    code: `${marketplaceCommands.codex}\n${target.codexCommand}`,
    note: "Start a new session after installing.",
    app: "Open <strong>Plugins</strong>, find the plugin and select <strong>Install</strong>.",
    docs: ["OpenAI plugin docs", "https://learn.chatgpt.com/docs/plugins"],
  },
  {
    id: "cursor",
    label: "Cursor",
    icon: "cursor",
    title: "Add this marketplace to Cursor",
    intro: "Plugins you install for your user work in the Cursor app and the Cursor Agent CLI.",
    code: `${marketplaceCommands.cursor}\n${target.cursorCommand}`,
    app: "Open <strong>Customize</strong>, find the plugin and select <strong>Install</strong>.",
    docs: ["Cursor plugin docs", "https://cursor.com/docs/plugins"],
  },
  {
    id: "gemini-cli",
    label: "Gemini CLI",
    icon: "gemini",
    title: "Install a local extension in Gemini CLI",
    intro: "Gemini CLI installs extensions from a local folder, so clone the repository first.",
    code: `git clone ${repositoryUrl}.git\ncd claude-codex-settings\n${target.geminiCommand}`,
    note: "Start a new Gemini CLI session after installing.",
    docs: ["Gemini CLI extension docs", "https://geminicli.com/docs/extensions/reference/"],
  },
  {
    id: "chatgpt",
    aliases: ["web-skill-uploads"],
    label: "ChatGPT",
    icon: "openai",
    title: "Upload a skill to ChatGPT",
    intro: "Personal skills work on eligible ChatGPT plans. Workspace admins can turn off uploads.",
    steps: [
      "Open <strong>chatgpt.com/skills</strong>",
      "Select <strong>+</strong>, then <strong>Upload a skill</strong>",
      "Choose the ZIP and wait for the security check",
      "Ask for something the skill covers",
    ],
    image: ["/tutorials/install-skill-chatgpt.webp", "ChatGPT Skills page with the upload menu and ZIP upload screen"],
    docs: ["ChatGPT skills docs", "https://help.openai.com/en/articles/20001066-skills-in-chatgpt"],
  },
  {
    id: "claude-ai",
    label: "Claude.ai",
    icon: "claude",
    title: "Upload a skill to Claude.ai",
    intro: "Custom skills need a supported Claude plan with code execution turned on.",
    steps: [
      "Open <strong>Customize</strong>, then <strong>Skills</strong>",
      "Select <strong>Add</strong>, then <strong>Upload skill</strong>",
      "Choose the ZIP and select <strong>Save</strong>",
      "Ask for something the skill covers",
    ],
    image: ["/tutorials/install-skill-claude.webp", "Claude Skills settings with the Add menu and ZIP upload screen"],
    docs: ["Claude skills docs", "https://support.claude.com/en/articles/12512180-use-skills-in-claude"],
  },
] as const
const supportedTabs = guideTabs.filter((tab) => {
  if (!compact) return true
  if ("steps" in tab) return Boolean(skill || target.components?.skills.length)
  return { "claude-code": target.claudeCommand, codex: target.codexCommand, cursor: target.cursorCommand, "gemini-cli": target.geminiCommand }[tab.id]
})
---

<section class:list={["guide-tabs", { "compact-install": compact }]} data-guide-tabs aria-label="Installation options">
  <div class="install-tool-tabs" role="tablist" aria-label="Choose where you install">
    {supportedTabs.map((tab, index) => (
      <button
        id={`tab-${tab.id}`}
        class:list={["install-tool-tab", { "is-active": index === 0 }]}
        type="button"
        role="tab"
        aria-controls={tab.id}
        aria-selected={index === 0 ? "true" : "false"}
        tabindex={index === 0 ? 0 : -1}
        data-aliases={"aliases" in tab ? tab.aliases.join(" ") : undefined}
      >
        <Icon name={tab.icon} size={17} />
        <span>{tab.label}</span>
      </button>
    ))}
  </div>
  {supportedTabs.map((tab, index) => (
    <div id={tab.id} class="guide-panel" role="tabpanel" aria-labelledby={`tab-${tab.id}`} hidden={index > 0}>
      <div class="guide-main">
        {!compact && <h2>{tab.title}</h2>}
        {!compact && <p>{tab.intro}</p>}
        {"code" in tab && (
          <div class="command">
            <pre><code>{tab.code.split("\n").map((line) => <span>{line}</span>)}</code></pre>
            <button class="icon-button code-copy" type="button" data-copy={tab.code} aria-label={`Copy ${tab.label} commands`}><Icon name="copy" size={16} /></button>
          </div>
        )}
        {"note" in tab && <p set:html={tab.note} />}
        {"steps" in tab && (
          <>
            {skill && (skill.downloadUrl
              ? <a class="button primary" href={skill.downloadUrl} data-download-asset={skill.asset}>Download {skill.name}.zip</a>
              : <p>No ZIP release yet. Install the plugin from a coding agent tab.</p>
            )}
            {plugin && <p><a class="inline-link" href="#skills">Download a skill ZIP</a> from the list below.</p>}
            <ol class="steps-list">{tab.steps.map((step) => <li set:html={step} />)}</ol>
          </>
        )}
        {compact && "app" in tab && <p class="install-app"><strong>Desktop app:</strong> <span set:html={tab.app} /></p>}
        {!compact && <a class="official-link" href={tab.docs[1]}>{tab.docs[0]}</a>}
      </div>
      {!compact && "app" in tab && (
        <div class="guide-aside">
          <h3>In the desktop app</h3>
          <p set:html={tab.app} />
        </div>
      )}
      {!compact && "image" in tab && (
        <figure class="tutorial-figure">
          <img src={tab.image[0]} alt={tab.image[1]} width="1200" height="760" loading="lazy" />
        </figure>
      )}
    </div>
  ))}
</section>
{!compact && <section class="content-section guide-notes">
  <div>
    <h2>Use a plugin in a new session</h2>
    <p>Start a new session so the agent loads the plugin, then name the skill or describe the task.</p>
    <pre class="code-sample"><code>{`Use the simplify skill to review my staged diff.
Use the humanize skill to revise this README.`}</code></pre>
  </div>
  <div>
    <h2>Keep the folder inside the ZIP</h2>
    <p>Claude.ai expects the skill folder inside the archive, and every download here keeps it. Read <code>SKILL.md</code> and any scripts before you upload.</p>
    <pre class="code-sample"><code>{`skill-name.zip
└── skill-name/
    ├── SKILL.md
    ├── scripts/
    └── references/`}</code></pre>
  </div>
</section>}

<script>
  document.querySelectorAll<HTMLElement>("[data-guide-tabs]").forEach((guide) => {
    const tabs = [...guide.querySelectorAll<HTMLButtonElement>("[role=tab]")]
    const panels = tabs.map((tab) => document.getElementById(tab.getAttribute("aria-controls")!)!)
    const select = (index: number) =>
      tabs.forEach((tab, tabIndex) => {
        const active = tabIndex === index
        tab.classList.toggle("is-active", active)
        tab.setAttribute("aria-selected", String(active))
        tab.tabIndex = active ? 0 : -1
        panels[tabIndex].hidden = !active
      })
    const fromHash = () => {
      const id = location.hash.slice(1)
      const index = tabs.findIndex((tab) => tab.getAttribute("aria-controls") === id || tab.dataset.aliases?.split(" ").includes(id))
      if (index < 0) return false
      select(index)
      guide.scrollIntoView()
      return true
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        select(index)
        history.replaceState(null, "", `#${tab.getAttribute("aria-controls")}`)
      })
      tab.addEventListener("keydown", (event) => {
        const next = { ArrowLeft: index - 1, ArrowRight: index + 1, Home: 0, End: tabs.length - 1 }[event.key]
        if (next === undefined) return
        event.preventDefault()
        const target = (next + tabs.length) % tabs.length
        tabs[target].focus()
        tabs[target].click()
      })
    })
    window.addEventListener("hashchange", fromHash)
    fromHash()
  })
</script>
