---
import Editor from "./Editor.astro"
import Icon from "./Icon.astro"
import PluginCard from "./PluginCard.astro"
import { codingTools, pluginByName, plugins, repositoryStars, repositoryUrl } from "../lib/content"
import { translations, type Locale } from "../lib/i18n"

interface Props {
  locale: Locale
  providers: string
}

const { locale, providers } = Astro.props
const copy = translations[locale].settings
const stars = await repositoryStars()
---

<section class="settings-hero">
  <div class="hero-copy">
    <h1>{copy.hero.title}</h1>
    <p>{copy.hero.description(providers)}</p>
    <div class="hero-actions">
      <a class="button primary" href={repositoryUrl} target="_blank" rel="noreferrer">
        <Icon name="github" size={23} />{copy.hero.repository}
        {stars && <span class="star-count"><Icon name="star" size={15} />{stars.toLocaleString(locale)}<span class="sr-only"> {translations[locale].stars}</span></span>}
      </a>
      <a class="button secondary" href="/guides/install-agent-skills/">{copy.hero.install} <Icon name="arrow" size={19} /></a>
    </div>
  </div>
  <Editor locale={locale} />
</section>

<section class="section tool-band" id="install">
  <div class="section-intro">
    <h2>{copy.configuration.title}</h2>
    <p>{copy.configuration.description}</p>
  </div>
  <div class="tool-band-grid">
    {codingTools.map(({ icon, label, marketplace }, index) => {
      const command = marketplace ?? pluginByName.get("simplify")!.geminiCommand
      return (
        <div class="tool-band-item">
          <strong><Icon name={icon} size={24} />{label}</strong>
          <span>{copy.configuration.tools[index]}</span>
          <div class="command-line">
            <code>{command}</code>
            <button class="icon-button" type="button" data-copy={command} aria-label={`${copy.configuration.copyCommand} ${label}`}><Icon name="copy" size={18} /></button>
          </div>
        </div>
      )
    })}
  </div>
</section>

<section class="section settings-plugins" id="plugins">
  <div class="section-intro">
    <h2>{copy.plugins.title}</h2>
    <p>{copy.plugins.description}</p>
  </div>
  <div class="plugin-grid">{plugins.slice(0, 6).map((plugin) => <PluginCard {plugin} />)}</div>
  <a class="text-link" href="/plugins/">{copy.plugins.browse} ({plugins.length}) <Icon name="arrow" size={18} /></a>
</section>
