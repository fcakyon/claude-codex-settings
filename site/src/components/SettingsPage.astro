---
import Editor from "./Editor.astro"
import Icon from "./Icon.astro"
import { codingTools, featured, plugins, repositoryStars, repositoryUrl } from "../lib/content"
import { translations, type Locale } from "../lib/i18n"

interface Props {
  locale: Locale
  providers: string
}

const { locale, providers } = Astro.props
const copy = translations[locale].settings
const stars = await repositoryStars()
---

<section class="settings-hero">
  <div class="hero-copy">
    <h1>{copy.hero.title}</h1>
    <p>{copy.hero.description(providers)}</p>
    <div class="hero-actions">
      <a class="button primary" href={repositoryUrl} target="_blank" rel="noreferrer">
        <Icon name="github" size={23} />{copy.hero.repository}
        {stars && <span class="star-count"><Icon name="star" size={15} />{stars.toLocaleString(locale)}<span class="sr-only"> {translations[locale].stars}</span></span>}
      </a>
      <a class="button secondary" href="#install">{copy.hero.install} <Icon name="arrow" size={19} /></a>
    </div>
  </div>
  <Editor locale={locale} />
</section>

<section class="section tool-section" id="configuration">
  <div class="section-intro">
    <h2>{copy.configuration.title}</h2>
    <p>{copy.configuration.description}</p>
  </div>
  <div class="tool-rail">
    {codingTools.map(({ icon, label }, index) => (
      <div><Icon name={icon} size={26} /><strong>{label}</strong><span>{copy.configuration.tools[index]}</span></div>
    ))}
  </div>
</section>

<section class="section install-section" id="install">
  <div>
    <h2>{copy.install.title}</h2>
    <p>{copy.install.description}</p>
  </div>
  <div class="install-steps">
    {codingTools.filter((tool) => tool.marketplace).map((tool) => <div><span>{tool.label}</span><code>{tool.marketplace}</code></div>)}
  </div>
</section>

<section class="section settings-plugins" id="plugins">
  <div class="section-intro">
    <h2>{copy.plugins.title}</h2>
    <p>{copy.plugins.description}</p>
  </div>
  <div class="plugin-rail">
    {plugins.slice(0, featured.length).map((plugin) => <a href={`/plugins/${plugin.name}/`}><strong>{plugin.name}</strong><span>{plugin.description}</span><Icon name="arrow" size={18} /></a>)}
  </div>
  <a class="text-link" href="/plugins/">{copy.plugins.browse} <Icon name="arrow" size={18} /></a>
</section>
