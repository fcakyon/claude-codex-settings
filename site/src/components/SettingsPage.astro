---
import Editor from "./Editor.astro"
import Icon from "./Icon.astro"
import { featured, modelProviders, plugins, repositoryStars, repositoryUrl } from "../lib/content"
import { translations, type Locale } from "../lib/i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = translations[locale].settings
const stars = await repositoryStars()
const tools = [
  ["claude", "Claude Code"],
  ["openai", "Codex CLI"],
  ["cursor", "Cursor"],
  ["gemini", "Gemini CLI"],
] as const
---

<section class="settings-hero">
  <div class="hero-copy">
    <h1>{copy.hero.title}</h1>
    <p>{copy.hero.description}</p>
    <div class="hero-actions">
      <a class="button primary" href={repositoryUrl} target="_blank" rel="noreferrer">
        <Icon name="github" size={23} />{copy.hero.repository}
        {stars && <span class="star-count"><Icon name="star" size={15} />{stars.toLocaleString(locale === "en" ? "en-US" : "zh-CN")}<span class="sr-only"> {copy.hero.stars}</span></span>}
      </a>
      <a class="button secondary" href="#install">{copy.hero.install} <Icon name="arrow" size={19} /></a>
    </div>
  </div>
  <Editor locale={locale} />
</section>

<style is:global>
  .provider-ledger { border-top: 1px solid var(--border); }
  .provider-head, .provider-row { display: grid; grid-template-columns: 140px 1.15fr 1fr 1.2fr 130px; gap: 24px; align-items: start; }
  .provider-head { padding: 0 20px 16px; color: var(--muted); font: 700 12px/1.3 var(--mono); text-transform: uppercase; letter-spacing: .05em; }
  .provider-row { min-height: 148px; padding: 28px 20px; border-bottom: 1px solid var(--border); }
  .provider-row > strong { font-size: 20px; }
  .provider-row div { display: grid; gap: 8px; min-width: 0; }
  .provider-row span { color: var(--muted); line-height: 1.45; }
  .provider-row code { color: var(--text); font: 12px/1.45 var(--mono); overflow-wrap: anywhere; }
  .provider-label { display: none; }
  .model-list { color: var(--text) !important; font: 13px/1.55 var(--mono); }
  .provider-links a { color: var(--link); font-weight: 700; }

  @media (max-width: 1100px) {
    .provider-head, .provider-row { grid-template-columns: 120px 1fr 1fr; }
    .provider-head span:nth-child(4), .provider-head span:nth-child(5) { display: none; }
    .provider-row > div:nth-child(4), .provider-row > div:nth-child(5) { grid-column: 2 / 4; }
  }

  @media (max-width: 760px) {
    .provider-head { display: none; }
    .provider-row { grid-template-columns: 1fr; gap: 20px; padding-inline: 0; }
    .provider-row > div:nth-child(4), .provider-row > div:nth-child(5) { grid-column: 1; }
    .provider-label { display: block; color: var(--muted); font: 700 11px/1.3 var(--mono); text-transform: uppercase; letter-spacing: .04em; }
  }
</style>

<section class="section tool-section" id="configuration">
  <div class="section-intro">
    <h2>{copy.configuration.title}</h2>
    <p>{copy.configuration.description}</p>
  </div>
  <div class="tool-rail">
    {tools.map(([icon, label], index) => (
      <div><Icon name={icon} size={26} /><strong>{label}</strong><span>{copy.configuration.tools[index]}</span></div>
    ))}
  </div>
</section>

<section class="section provider-section" id="providers">
  <div class="section-intro">
    <h2>{copy.providers.title}</h2>
    <p>{copy.providers.description}</p>
  </div>
  <div class="provider-ledger">
    <div class="provider-head" aria-hidden="true">
      {copy.providers.columns.map((label) => <span>{label}</span>)}
    </div>
    {modelProviders.map((provider) => (
      <article class="provider-row">
        <strong>{provider.name}</strong>
        <div><span class="provider-label">{copy.providers.columns[1]}</span><span>{copy.providers.claudeDirect}</span><code>{provider.baseUrl}</code></div>
        <div><span class="provider-label">{copy.providers.columns[2]}</span><span>{provider.codexUrl ? copy.providers.codexProxy : copy.providers.codexUnavailable}</span>{provider.codexModel && <code>{provider.codexModel}</code>}</div>
        <div><span class="provider-label">{copy.providers.columns[3]}</span><span class="model-list">{provider.models.join(" · ")}</span></div>
        <div class="provider-links">
          <span class="provider-label">{copy.providers.columns[4]}</span>
          <a href={provider.claudeUrl}>{copy.providers.claudeSource}</a>
          {provider.codexUrl && <a href={provider.codexUrl}>{copy.providers.codexSource}</a>}
        </div>
      </article>
    ))}
  </div>
</section>

<section class="section install-section" id="install">
  <div>
    <h2>{copy.install.title}</h2>
    <p>{copy.install.description}</p>
  </div>
  <div class="install-steps">
    <div><span>Claude Code</span><code>claude plugin marketplace add fcakyon/claude-codex-settings</code></div>
    <div><span>Codex CLI</span><code>codex plugin marketplace add fcakyon/claude-codex-settings</code></div>
  </div>
</section>

<section class="section settings-plugins" id="plugins">
  <div class="section-intro">
    <h2>{copy.plugins.title}</h2>
    <p>{copy.plugins.description}</p>
  </div>
  <div class="plugin-rail">
    {plugins.slice(0, featured.length).map((plugin) => <a href={plugin.href}><strong>{plugin.name}</strong><span>{plugin.description}</span><Icon name="arrow" size={18} /></a>)}
  </div>
  <a class="text-link" href="https://agentplugins.net">{copy.plugins.browse} <Icon name="arrow" size={18} /></a>
</section>
