---
import Icon from "./Icon.astro"
import { repositoryStars, repositoryUrl, site, type SiteVariant } from "../lib/content"
import { locales, translations, type Locale } from "../lib/i18n"

interface Props {
  locale: Locale
  variant: SiteVariant
  showLanguage?: boolean
}

const { locale, variant, showLanguage = true } = Astro.props
const copy = translations[locale]
const settings = variant === "settings"
const stars = await repositoryStars()
const nav = copy[variant].nav
const languageLocale = locales[locale].alternate
---

<header class="site-header">
  <a class="brand" href={locales[locale].path}>{settings && <img src="/favicon-settings.svg" alt="" width="28" height="28" />}{site.name}</a>
  <nav aria-label={copy.primaryNav}>
    {nav.map(([label, href]) => <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? "true" : undefined}>{label}</a>)}
  </nav>
  <div class="header-actions">
    {showLanguage && <a class="language-link" href={locales[languageLocale].path} hreflang={languageLocale}>{copy.languageLabel}</a>}
    <a class="button primary header-cta" href={repositoryUrl} target="_blank" rel="noreferrer">
      <Icon name="github" size={21} />
      <span class="cta-label">{copy.github}</span>
      {stars && <span class="star-count"><Icon name="star" size={15} />{stars.toLocaleString(locale)}<span class="sr-only"> {copy.stars}</span></span>}
    </a>
  </div>
</header>

<style is:global>
  .header-actions { justify-self: end; display: flex; align-items: center; gap: 18px; }
  .language-link { color: var(--muted); font-size: 14px; font-weight: 700; white-space: nowrap; }
  .language-link:hover { color: var(--text); }

  @media (max-width: 760px) {
    .header-actions { display: contents; }
    .header-cta { grid-area: actions; }
    .language-link { grid-area: nav; justify-self: end; align-self: center; padding-block: 10px; font-size: 13px; }
  }
</style>
